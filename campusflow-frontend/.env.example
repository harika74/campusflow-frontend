# Base URL of your Django REST Framework backend.
# Keep the trailing slash if your backend uses it.
VITE_API_BASE_URL=http://127.0.0.1:8000

# API paths. Change these if your Django urls.py uses different paths.
VITE_TASKS_ENDPOINT=/api/tasks/
VITE_LOGIN_ENDPOINT=/api/auth/login/
VITE_REGISTER_ENDPOINT=/api/auth/register/
VITE_LOGOUT_ENDPOINT=/api/auth/logout/

# Set to true only if your backend uses cookie/session authentication.
VITE_WITH_CREDENTIALS=false
